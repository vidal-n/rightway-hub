{
  // Cloudflare Worker that serves the static app in /public and the API in /src.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rightway-hub",
  "main": "src/worker.js",
  "compatibility_date": "2024-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Files here are not public: the Worker runs first and only hands them to closers and owners (the pricing reference).
    "run_worker_first": ["/training/pricing/*"]
  },
  "observability": { "enabled": true },
  // Database (Cloudflare D1). Tables are created by the app on first use.
  "d1_databases": [
    { "binding": "DB", "database_name": "rightway-hub", "database_id": "914f7329-05da-4550-82f1-53e9026fbeb0" }
  ],
  // Photo storage (Cloudflare R2).
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "rightway-media" }
  ],
  // Every minute: works through the automatic ranking scan queue (does nothing when it is empty).
  "triggers": { "crons": ["* * * * *"] },
  // Keep variables and secrets added in the Cloudflare dashboard when deploying from GitHub.
  "keep_vars": true,
  // Copies Build secrets into the Worker (see scripts/bake-secrets.mjs).
  "build": { "command": "node scripts/bake-secrets.mjs && node scripts/stamp-sw.mjs" }
  // Secrets (set in the Cloudflare dashboard, never in this file):
  //   DATAFORSEO_LOGIN, DATAFORSEO_PASSWORD, ACCESS_KEY, PAGESPEED_KEY (optional)
}
